# Copy to .env. Never commit this file.
SUPABASE_URL=https://your-project.supabase.co
# Project Settings -> API -> service_role key. Server-side only!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must match the x-webhook-secret header configured on the Supabase webhook.
WEBHOOK_SECRET=change-me

# Optional push notifications. Without these the webhook still returns 200.
FIREBASE_PROJECT_ID=your-firebase-project
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Alternatively provide the service account JSON inline:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
